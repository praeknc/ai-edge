# Copy to .env (or export these) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Thinking effort for the chat agent: low suits short answers; try medium if tool choice is weak
CLAUDE_EFFORT=low
# 1 = answer a few canned questions with keyword matching, no API key needed
MOCK_LLM=1
