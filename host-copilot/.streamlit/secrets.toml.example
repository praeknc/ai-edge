# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Never commit the real file: it holds your API key.

# Send the app's Claude requests through MIT's Parley proxy
ANTHROPIC_BASE_URL = "https://parley.api.mit.edu"
ANTHROPIC_API_KEY = "sk-parley-v1-...your-key..."

# Use Claude for typed questions ("1" = offline keyword rules, no key needed)
MOCK_LLM = "0"
CLAUDE_MODEL = "claude-sonnet-5-5"
CLAUDE_EFFORT = "low"

# Server-side refusal fallback is an Anthropic beta that a proxy may not pass through; "1" to turn it on
CLAUDE_SERVER_FALLBACK = "0"
